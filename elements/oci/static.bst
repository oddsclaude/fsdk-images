kind: script

build-depends:
  - freedesktop-sdk.bst:components/oci-builder.bst
  - static/static-init-script.bst
  - filename: static/static-runtime.bst
    config:
      location: /layer

variables:
  # Shared slim recipe plus the exact pinned FSDK point release
  # (%{fsdk-version}), regenerated by `just bst` from elements/freedesktop-sdk.bst.
  (@):
    - include/slim.yml
    - include/fsdk-version.yml

config:
  commands:
    - "%{slim-distroless-commands}"
    - |
      if [ -d /initial_scripts ]; then
        for i in /initial_scripts/*; do
          "${i}" /layer
        done
      fi

    - |
      cd "%{install-root}"
      build-oci <<EOF
      mode: oci
      gzip: disabled
      images:
      - os: linux
        architecture: "%{go-arch}"
        layer: /layer
        comment: "fsdk-images static image"
        config:
          Labels:
            'org.opencontainers.image.title': 'static'
            'org.opencontainers.image.description': 'Distroless static image carved from freedesktop-sdk — no glibc, for statically compiled binaries'
            'org.opencontainers.image.vendor': 'OCI-Shipyard'
            'org.opencontainers.image.licenses': 'Apache-2.0'
            'org.opencontainers.image.url': 'https://github.com/OCI-Shipyard/fsdk-images'
            'org.opencontainers.image.source': 'https://github.com/OCI-Shipyard/fsdk-images'
        index-annotations:
          'org.opencontainers.image.ref.name': 'ghcr.io/oci-shipyard/static:%{fsdk-version}'
      EOF
