kind: script

build-depends:
  - freedesktop-sdk.bst:components/oci-builder.bst
  - filename: arch/arch-rootfs.bst
    config:
      location: /layer

variables:
  # Shared arch slim recipe plus the exact pinned FSDK point release
  # (%{fsdk-version}), regenerated by `just bst` from elements/freedesktop-sdk.bst.
  (@):
    - include/arch-slim.yml
    - include/fsdk-version.yml

config:
  commands:
    - "%{arch-slim-commands}"

    - |
      cd "%{install-root}"
      build-oci <<EOF
      mode: oci
      gzip: disabled
      images:
      - os: linux
        architecture: "%{go-arch}"
        layer: /layer
        comment: "fsdk-images arch image"
        config:
          Labels:
            'org.opencontainers.image.title': 'arch'
            'org.opencontainers.image.description': 'Minimal Arch Linux rootfs with pacman, carved from the official archlinux base image'
            'org.opencontainers.image.vendor': 'HuntedRaven7'
            'org.opencontainers.image.licenses': 'Apache-2.0'
            'org.opencontainers.image.url': 'https://github.com/HuntedRaven7/fsdk-images'
            'org.opencontainers.image.source': 'https://github.com/HuntedRaven7/fsdk-images'
        index-annotations:
          'org.opencontainers.image.ref.name': 'ghcr.io/huntedraven7/arch:%{fsdk-version}'
      EOF
